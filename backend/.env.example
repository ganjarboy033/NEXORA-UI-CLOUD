# Salin menjadi .env pada server. Jangan pernah masukkan nilai rahasia ke APK/Git.
PORT=8080
NODE_ENV=production
PUBLIC_BASE_URL=https://api-domain-anda.example
NEXORA_API_KEY=ganti-dengan-kunci-acak-panjang-minimal-32-karakter
DATABASE_URL=postgresql://nexora:password@localhost:5432/nexora
DATABASE_SSL=false
TELEGRAM_BOT_TOKEN=123456:ISI_TOKEN_BOT_DI_SERVER
TELEGRAM_STORAGE_CHAT_ID=-1001234567890
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_FILE_BASE=https://api.telegram.org/file/bot
MAX_UPLOAD_MB=50

# Opsional: Telegram Client API untuk login akun Telegram (bukan token bot).
# Ambil api_id dan api_hash dari https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
